.s_thanks EQUS "THANKS FOR PLAYING",0
.s_thanks2 EQUS "THE BETA",0
.s_time EQUS "TIME ",0
.s_kills EQUS "KILLS ",0
.s_earned EQUS "EARNED ",0
.s_bank EQUS "BANK ",0
.s_again EQUS "PRESS ",KEY,"SPACE",KEY," TO RETURN",0
